# Copy to .env.local and fill in from the Firebase console.
# With ANY of these missing the backend disables itself and the game runs
# fully offline — that is the intended fallback, not a failure.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=

# Set to 1 to point a local `npm run dev` at the emulator suite instead of
# real Firebase. Ignored in production builds.
VITE_FIREBASE_EMULATOR=0

# AdMob (store builds only — rewarded video is native, so web ignores these).
# Publisher ID: pub-4951837849307649
# Leave BLANK to use Google's test ad units. Testing with real units is how
# AdMob accounts get suspended for invalid traffic.
# Android and iOS are SEPARATE AdMob apps with separate unit ids.
#   Android app   ca-app-pub-4951837849307649~8549571254  (in AndroidManifest)
#   Android unit  ca-app-pub-4951837849307649/8476439121
#   iOS app       ca-app-pub-4951837849307649~3144221393  (in Info.plist)
#   iOS unit      ca-app-pub-4951837849307649/8357999563
#
# App ids live in the native manifests because the SDKs read them there.
# Only the UNIT ids belong here, and only in a production environment —
# blank means Google's test units, which is what you want while developing.
VITE_ADMOB_APP_ID_ANDROID=
VITE_ADMOB_REWARDED_ID_ANDROID=
VITE_ADMOB_APP_ID_IOS=
VITE_ADMOB_REWARDED_ID_IOS=
