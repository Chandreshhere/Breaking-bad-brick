# Copy to .env.local and fill in from the Firebase console.
# With ANY of the first four missing the backend disables itself and the game
# runs fully offline — that is the intended fallback, not a failure.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
# Required by Firebase Analytics on the WEB build only (looks like G-XXXXXXX).
# Native builds report through the Capacitor plugin instead and ignore this.
VITE_FIREBASE_MEASUREMENT_ID=

# ── Backend API origin ────────────────────────────────────────────────────
# Where the callable API is hosted. Accepts either a region or a full origin
# and speaks the same protocol to both, so this one line picks the host:
#   blank                                  Cloud Functions (needs Blaze)
#   https://<id>.lambda-url.<r>.on.aws     AWS Lambda      — docs/AWS.md
#   https://<service>.onrender.com         Render          — docs/RENDER.md
# Firestore, Auth, App Check and Remote Config stay on the free Spark plan
# whichever you choose.
VITE_BACKEND_URL=

# Set to 1 to point a local `npm run dev` at the emulator suite instead of
# real Firebase. Ignored in production builds.
VITE_FIREBASE_EMULATOR=0

# ── Privacy policy ────────────────────────────────────────────────────────
# A public, reachable URL. Both stores require one on the listing, AdMob
# requires one, and the in-game consent and privacy screens link to it.
# Leave blank and the link is hidden rather than rendered broken.
VITE_PRIVACY_POLICY_URL=

# ── Crash reporting ───────────────────────────────────────────────────────
# Sentry DSN. Blank disables upload entirely; the global error handlers still
# run and still feed the in-game `error` analytics event.
VITE_SENTRY_DSN=

# ── AdMob (store builds only — rewarded video is native, so web ignores) ──
# Publisher ID: pub-4951837849307649
# Leave BLANK to use Google's test ad units. Testing with real units is how
# AdMob accounts get suspended for invalid traffic.
# Android and iOS are SEPARATE AdMob apps with separate unit ids.
#   Android app   ca-app-pub-4951837849307649~8549571254  (in AndroidManifest)
#   Android unit  ca-app-pub-4951837849307649/8476439121
#   iOS app       ca-app-pub-4951837849307649~3144221393  (in Info.plist)
#   iOS unit      ca-app-pub-4951837849307649/8357999563
#
# App ids live in the native manifests because the SDKs read them there.
# Only the UNIT ids belong here, and only in a production environment —
# blank means Google's test units, which is what you want while developing.
#
# Both real units also need their server-side verification callback set, in
# the AdMob console, to the deployed function:
#   https://us-central1-<project-id>.cloudfunctions.net/admobSsv
# Until that is set, a completed ad grants nothing: the reward is minted by
# the SSV callback, never by the client.
VITE_ADMOB_APP_ID_ANDROID=
VITE_ADMOB_REWARDED_ID_ANDROID=
VITE_ADMOB_APP_ID_IOS=
VITE_ADMOB_REWARDED_ID_IOS=
