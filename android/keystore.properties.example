# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# Create the key once, and never lose it:
#
#   keytool -genkeypair -v \
#     -keystore ~/keys/breaking-bad-brick-upload.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Then back up BOTH the .jks and these passwords somewhere that survives
# this machine dying. Google Play ties the listing to this key permanently:
# if it is lost, com.breakingbadbrick.game can never be updated again.
#
# storeFile is resolved relative to android/app/, so an absolute path is
# safest.
storeFile=/absolute/path/to/breaking-bad-brick-upload.jks
storePassword=
keyAlias=upload
keyPassword=
